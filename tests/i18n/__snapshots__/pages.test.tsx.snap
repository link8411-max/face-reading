exports[`한국어 공용 컴포넌트 렌더가 그대로다(스냅숏) > MoreTests 1`] = `"<section aria-labelledby="more-tests-title" class="no-screenshot mt-6"><div class="flex items-baseline justify-between px-1"><h2 id="more-tests-title" class="text-sm font-bold">다른 테스트 둘러보기</h2><a class="text-[13px] text-accent-ink font-semibold" href="/all">전체 보기</a></div><ul class="flex gap-2.5 overflow-x-auto [scrollbar-width:none] -mx-4 px-4 mt-2.5"><li class="flex-none w-[148px]"><a class="press flex h-full flex-col gap-2 rounded-[20px] bg-card border border-line p-3" href="/animal"><img src="/images/cast/tiger-face.webp" alt="백호 캐릭터" width="44" height="44" loading="lazy" decoding="async" class="w-11 h-11 rounded-[14px] object-cover" style="background:#1B2436"/><span class="text-[14px] font-bold break-keep">동물상 테스트</span></a></li><li class="flex-none w-[148px]"><a class="press flex h-full flex-col gap-2 rounded-[20px] bg-card border border-line p-3" href="/samguk"><span class="text-[14px] font-bold break-keep">나는 삼국지 속 누구?</span></a></li><li class="flex-none w-[148px]"><a class="press flex h-full flex-col gap-2 rounded-[20px] bg-card border border-line p-3" href="/samguk/team"><span class="text-[14px] font-bold break-keep">우리 팀 삼국지</span></a></li><li class="flex-none w-[148px]"><a class="press flex h-full flex-col gap-2 rounded-[20px] bg-card border border-line p-3" href="/samguk/cup"><span class="text-[14px] font-bold break-keep">삼국지 장수 월드컵</span></a></li></ul></section>"`;

exports[`한국어 공용 컴포넌트 렌더가 그대로다(스냅숏) > NextTests 1`] = `"<section class="no-screenshot mt-4"><h2 class="text-sm font-bold mb-2">이 얼굴, 다른 테스트로도 볼까요?</h2><div class="grid grid-cols-2 gap-2"><a class="bg-card border border-line rounded-[22px] px-4 py-3.5 flex flex-col gap-1.5" href="/face2"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent-ink"><circle cx="12" cy="12" r="8.5"></circle><path d="M9 10.5h.01M15 10.5h.01M9 14.5c1.6 1.6 4.4 1.6 6 0"></path></svg><span class="text-[15px] font-bold">관상으로는?</span><span class="text-xs text-muted flex items-center gap-0.5">같은 사진으로 바로 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a><a class="bg-card border border-line rounded-[22px] px-4 py-3.5 flex flex-col gap-1.5" href="/samguk"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="text-accent-ink"><path d="M12 20L4 9a10 10 0 0 1 16 0z"></path><path d="M12 20V6M12 20L8 7.2M12 20l4-12.8"></path></svg><span class="text-[15px] font-bold">삼국지에선 누구?</span><span class="text-xs text-muted flex items-center gap-0.5">같은 사진으로 바로 <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"></path></svg></span></a></div></section>"`;

exports[`한국어 공용 컴포넌트 렌더가 그대로다(스냅숏) > PageGuide /face2 1`] = `"<section class="no-screenshot bg-paper text-ink border-t border-line"><div class="max-w-lg mx-auto px-4 py-10 space-y-6"><div class="text-center"><h2 class="font-serif text-[22px] font-bold break-keep">무료 AI 관상 테스트, 이렇게 봐요</h2></div><p class="leading-relaxed text-center text-muted">사진 한 장으로 눈·코·입·얼굴형을 측정해 전통 관상학으로 성격과 초년·중년·말년운, 분야별 운을 풀이해요.</p><div><h3 class="font-serif font-bold text-lg mb-3">관상 결과 유형 15가지</h3><ul class="grid grid-cols-1 sm:grid-cols-2 gap-2"><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">일찍 싹 트는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">길게 뻗은 얼굴에 이마가 앞서, 시작이 빠르고 호기심이 먼저 움직이는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">곧게 뻗는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">곧고 길게 뻗은 얼굴 한가운데에 힘이 실려, 한번 정한 길을 꾸준히 가는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">뿌리 깊은 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">길게 뻗은 얼굴에 턱까지 힘이 실려, 서두르지 않고 깊이 뿌리내리는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">번뜩이는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">넓게 트인 이마와 갸름한 턱선이 어우러져, 아이디어가 번뜩 떠오르는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">한창 타오르는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">이마와 갸름한 턱 사이 한가운데에 열기가 실려, 지금 이 순간에 몰입하는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">오래 데우는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">갸름한 턱선까지 힘이 내려와, 천천히 오래 온기를 지키는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">터전이 단단한 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">둥글고 넉넉한 얼굴에 이마가 든든해, 기반을 먼저 다지고 움직이는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">곳간이 든든한 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">둥글고 넉넉한 얼굴 한가운데에 힘이 실려, 쌓고 지키는 데 강한 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">쉼터가 되는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">둥글고 넉넉한 얼굴이 턱까지 이어져, 곁에 있으면 마음이 놓이는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">설계하는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">각지고 또렷한 윤곽에 이마가 앞서, 계획을 먼저 그리고 움직이는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">결단하는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">각지고 또렷한 얼굴 한가운데에 힘이 실려, 고르고 정하는 데 망설임이 적은 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">끝까지 지키는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">각지고 또렷한 턱선에 힘이 실려, 맡은 일을 끝까지 해내는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">생각이 깊은 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">둥글고 부드러운 얼굴에 이마가 앞서, 오래 생각하고 깊이 헤아리는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">사람을 잇는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">둥글고 부드러운 얼굴 한가운데에 힘이 실려, 사람과 사람 사이를 잇는 상으로 풀어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">바다처럼 품는 상</p><p class="mt-1 text-[14px] leading-relaxed text-muted">둥글고 부드러운 얼굴이 턱까지 이어져, 넓게 받아들이고 품는 상으로 풀어요.</p></li></ul></div><div><h3 class="font-serif font-bold text-lg mb-3">부위별로 보는 관상</h3><ul class="grid grid-cols-1 sm:grid-cols-2 gap-2"><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">눈</p><p class="mt-1 text-[14px] leading-relaxed text-muted">관상에서는 마음이 드러나는 창으로 보아 가장 비중 있게 다뤄요. 눈의 크기와 두 눈 사이 간격에 따라 풀이가 달라져요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">코</p><p class="mt-1 text-[14px] leading-relaxed text-muted">재물과 자존심을 나타내는 부위로 봐요. 콧대의 길이와 콧방울의 넓이에 따라 인상과 풀이가 달라져요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">입</p><p class="mt-1 text-[14px] leading-relaxed text-muted">말씨와 애정을 나타내는 부위로 봐요. 입의 크기와 입술의 두께에 따라 풀이가 달라져요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">이마</p><p class="mt-1 text-[14px] leading-relaxed text-muted">초년의 흐름을 나타내는 부위로 봐요. 이마가 높은지 낮은지에 따라 지적인 인상과 실용적인 인상으로 나뉘어요.</p></li><li class="bg-card rounded-[18px] border border-line px-4 py-3"><p class="font-bold">턱</p><p class="mt-1 text-[14px] leading-relaxed text-muted">말년의 안정을 나타내는 부위로 봐요. 턱이 뾰족한지, 둥근지, 각진지에 따라 섬세하거나 온화하거나 단단한 인상이에요.</p></li></ul></div><details class="group bg-card rounded-[22px] border border-line px-5 py-4"><summary class="font-bold cursor-pointer list-none flex justify-between items-center">자세히 보기<span class="transition group-open:rotate-180" aria-hidden="true">▾</span></summary><div class="mt-4 space-y-3 leading-relaxed"><p>관상은 얼굴의 생김새로 사람의 성격과 운의 흐름을 읽는 동양의 전통 학문이에요. 예로부터 이마는 초년, 코와 광대는 중년, 입과 턱은 말년을 나타낸다고 보았고, 눈은 마음이 드러나는 창으로 여겨 가장 중요하게 다뤘어요.</p><p>운명을 읽다의 AI 관상 테스트는 사진 한 장에서 얼굴 기준점 478개를 찾아 눈의 크기와 눈꼬리 방향, 코의 길이와 콧볼, 입의 크기와 입꼬리, 이마와 턱의 비율, 전체 얼굴형을 측정해요. 측정한 특징을 전통 관상학의 해석과 짝지어 초년운·중년운·말년운과 재물운, 애정운, 직장운, 건강운, 대인운을 알려드려요.</p><p>횟수 제한 없이 무료로 여러 번 해볼 수 있으니 가족이나 친구 사진으로도 재미 삼아 비교해 보세요.</p><div><h3 class="font-bold mb-1">이목구비별 풀이</h3><p>눈은 마음과 지혜, 코는 재물과 자존심, 입은 말과 애정, 이마는 초년의 복, 턱은 말년의 안정과 관련 있다고 봐요. 각 부위의 생김새에 따라 다른 해석을 보여드려요.</p></div><div><h3 class="font-bold mb-1">초년·중년·말년운</h3><p>얼굴을 위·가운데·아래 세 부분(삼정)으로 나눠 인생의 시기별 흐름을 점수와 함께 풀이해요.</p></div><div><h3 class="font-bold mb-1">분야별 운 점수</h3><p>재물운, 애정운, 직장운, 건강운, 대인운을 각각 점수로 보여주고, 타고난 성격의 장점과 조심하면 좋은 점도 함께 알려드려요.</p></div></div></details><div><h3 class="font-serif font-bold text-lg mb-3">자주 묻는 질문</h3><div class="space-y-2"><details class="bg-card rounded-[18px] border border-line px-4 py-3"><summary class="font-medium cursor-pointer">사진이 저장되나요?</summary><p class="mt-2 leading-relaxed">아니요. 얼굴 분석은 사용 중인 브라우저 안에서만 이뤄지고, 사진은 서버로 전송되거나 저장되지 않아요. 페이지를 닫으면 사진 정보도 사라져요.</p></details><details class="bg-card rounded-[18px] border border-line px-4 py-3"><summary class="font-medium cursor-pointer">정말 무료인가요? 횟수 제한이 있나요?</summary><p class="mt-2 leading-relaxed">완전히 무료이고 횟수 제한도 없어요. 회원가입이나 로그인도 필요하지 않아요.</p></details><details class="bg-card rounded-[18px] border border-line px-4 py-3"><summary class="font-medium cursor-pointer">어떤 사진이 좋나요?</summary><p class="mt-2 leading-relaxed">정면을 보고 찍은 밝은 사진이 가장 좋아요. 고개를 많이 돌렸거나 얼굴 일부가 가려지면 기준점을 정확히 찾기 어려워 결과가 달라질 수 있어요.</p></details><details class="bg-card rounded-[18px] border border-line px-4 py-3"><summary class="font-medium cursor-pointer">같은 사람인데 사진마다 결과가 달라요.</summary><p class="mt-2 leading-relaxed">표정, 각도, 조명에 따라 이목구비의 비율이 조금씩 다르게 측정돼요. 무표정한 정면 사진으로 하면 가장 일관된 결과를 볼 수 있어요.</p></details><details class="bg-card rounded-[18px] border border-line px-4 py-3"><summary class="font-medium cursor-pointer">관상 결과를 믿어도 되나요?</summary><p class="mt-2 leading-relaxed">관상은 전통적으로 전해 오는 해석이고 과학적으로 검증된 것은 아니에요. 나를 돌아보는 재미있는 계기로 가볍게 즐겨 주세요.</p></details></div></div><div><h3 class="font-serif font-bold text-lg mb-3">다른 테스트도 해보세요</h3><div class="grid grid-cols-1 gap-2"><a class="bg-card rounded-full border border-line px-5 py-3 font-medium hover:border-accent/50 transition" href="/animal">동물상 테스트</a><a class="bg-card rounded-full border border-line px-5 py-3 font-medium hover:border-accent/50 transition" href="/samguk">나는 삼국지 속 누구?</a><a class="bg-card rounded-full border border-line px-5 py-3 font-medium hover:border-accent/50 transition" href="/fortune">사주 신년운세</a></div></div></div><script type="application/ld+json">{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"사진이 저장되나요?","acceptedAnswer":{"@type":"Answer","text":"아니요. 얼굴 분석은 사용 중인 브라우저 안에서만 이뤄지고, 사진은 서버로 전송되거나 저장되지 않아요. 페이지를 닫으면 사진 정보도 사라져요."}},{"@type":"Question","name":"정말 무료인가요? 횟수 제한이 있나요?","acceptedAnswer":{"@type":"Answer","text":"완전히 무료이고 횟수 제한도 없어요. 회원가입이나 로그인도 필요하지 않아요."}},{"@type":"Question","name":"어떤 사진이 좋나요?","acceptedAnswer":{"@type":"Answer","text":"정면을 보고 찍은 밝은 사진이 가장 좋아요. 고개를 많이 돌렸거나 얼굴 일부가 가려지면 기준점을 정확히 찾기 어려워 결과가 달라질 수 있어요."}},{"@type":"Question","name":"같은 사람인데 사진마다 결과가 달라요.","acceptedAnswer":{"@type":"Answer","text":"표정, 각도, 조명에 따라 이목구비의 비율이 조금씩 다르게 측정돼요. 무표정한 정면 사진으로 하면 가장 일관된 결과를 볼 수 있어요."}},{"@type":"Question","name":"관상 결과를 믿어도 되나요?","acceptedAnswer":{"@type":"Answer","text":"관상은 전통적으로 전해 오는 해석이고 과학적으로 검증된 것은 아니에요. 나를 돌아보는 재미있는 계기로 가볍게 즐겨 주세요."}}]}</script></section>"`;

