exports[`한국어 공용 컴포넌트 렌더가 그대로다(스냅숏) > FaceMatchCard 1`] = `"<article class="relative overflow-hidden bg-card border border-line rounded-[30px] px-[22px] pt-6 pb-5 flex flex-col text-ink"><p class="text-xs font-medium text-accent-ink">연인 궁합</p><p class="font-serif font-bold text-[22px] mt-2 break-keep">고양이상 <span class="text-muted font-normal">×</span> 강아지상</p><h2 class="font-serif font-bold text-[30px] leading-[1.3] mt-3 text-accent-ink break-keep">연인 궁합 59점</h2><p class="self-start mt-2 text-sm font-medium px-3 py-1 rounded-full bg-card-2">노력하면 빛나는 사이</p><div class="bg-card-2 rounded-[18px] mt-4 px-4 py-3.5 flex flex-col gap-2 text-[13px] leading-relaxed"><p>고양이상의 신비로움과 강아지상의 친근함이 만나 서로를 채워 줘요.</p><p>조금씩 맞춰 갈수록 단단해지는 사이예요.</p></div><p class="mt-3 text-[13px] text-muted">친구 58점 · 짝사랑 55점</p><div class="flex justify-between items-center mt-3.5 text-[11px] text-muted"><span class="font-serif font-bold text-xs text-ink">운명을 읽다</span><span>unse-ai.com</span></div></article>"`;

exports[`한국어 공용 컴포넌트 렌더가 그대로다(스냅숏) > GenderPills 1`] = `"<div role="radiogroup" aria-label="성별" class="grid grid-cols-2 gap-2"><button type="button" role="radio" aria-checked="false" class="h-12 rounded-full border text-[15px] font-medium transition disabled:opacity-60 bg-card text-ink border-line">여자</button><button type="button" role="radio" aria-checked="true" class="h-12 rounded-full border text-[15px] font-medium transition disabled:opacity-60 bg-ink text-paper border-ink">남자</button></div>"`;

exports[`한국어 공용 컴포넌트 렌더가 그대로다(스냅숏) > GuansangResultView 1`] = `"<link rel="preload" as="image" href="/images/cast/haetae.webp"/><div class="pb-6 animate-fade-in"><article class="reveal-card relative overflow-hidden bg-card border border-line rounded-[30px] px-[22px] pt-6 pb-5 flex flex-col text-ink"><svg width="120" height="120" viewBox="0 0 120 120" fill="none" aria-hidden="true" class="absolute -right-2.5 -top-1.5"><circle cx="74" cy="46" r="32" fill="#F7F8FC"></circle><circle cx="90" cy="36" r="29" fill="#EEF1FA"></circle><path d="M26 26l2 5 5 2-5 2-2 5-2-5-5-2 5-2z" fill="#2D55FF"></path></svg><p class="relative text-xs font-medium text-accent-ink">AI 관상</p><h2 class="relative font-serif font-bold text-[25px] leading-[1.4] mt-2 pr-16 break-keep">곳간이 든든한 상</h2><p class="relative text-[13px] leading-relaxed text-muted mt-2">둥글고 넉넉한 얼굴 한가운데에 힘이 실려, 쌓고 지키는 데 강한 상으로 풀어요.</p><div class="flex gap-4 mt-[18px] items-center"><div class="reveal-pop flex-none" style="--d:0.35s"><img src="/images/cast/haetae.webp" alt="해태 캐릭터" width="104" height="104" class="w-[104px] h-[104px] rounded-[26px] object-cover" style="background:#2A2116"/></div><div class="flex-1 flex flex-wrap gap-1.5"><span class="reveal-pop text-xs bg-card-2 rounded-full px-3 py-1.5" style="--d:0.7s">둥글고 넉넉한 얼굴</span><span class="reveal-pop text-xs bg-card-2 rounded-full px-3 py-1.5" style="--d:0.82s">코·광대가 센 얼굴</span></div></div><div class="bg-card-2 rounded-[18px] mt-4 px-4 py-3.5 flex flex-col gap-2"><p class="text-[13px] leading-relaxed"><span class="font-bold text-accent-ink">두드러진 자리 · 돈 자리(코)</span> 콧대가 길고 콧방울이 넉넉해 돈이 붙는 상으로 풀어요.</p><p class="text-[13px] leading-relaxed"><span class="font-bold text-accent-ink">고른 자리 · 일 자리(이마)</span> 이마가 얼굴과 고르게 어우러져 일을 차분하게 풀어 가는 상으로 풀어요.</p><p class="text-[13px] leading-relaxed"><span class="font-bold text-accent-ink">가꿀수록 자라는 자리 · 사랑 자리(눈꼬리 옆)</span> 눈꼬리 옆이 단정하게 모여 속마음을 아끼는 인상이에요. 좋았던 점을 말로 먼저 건네면 자라요. 좋았던 점을 말로 한 번 먼저 건네면 사랑 자리가 자라요.</p><p class="text-[13px] leading-relaxed"><span class="font-bold text-accent-ink">고른 자리 · 곁 사람 자리(눈썹)</span> 눈썹의 길이와 결이 고르게 이어져 편하게 어울리는 상으로 풀어요.</p><p class="text-[13px] leading-relaxed"><span class="font-bold text-accent-ink">두드러진 자리 · 받쳐 주는 자리(턱)</span> 턱선이 단단하게 받쳐 줘 끝까지 버티는 힘이 든든한 상으로 풀어요.</p></div><div class="flex justify-between items-center mt-3.5 text-[11px] text-muted"><span class="font-serif font-bold text-xs text-ink">운명을 읽다</span><span>unse-ai.com</span></div></article><p class="mt-3 text-center text-[11px] text-muted leading-relaxed">토형 · 중정 · 유파마다 얼굴형 분류가 조금씩 달라요</p><section class="mt-4 bg-card border border-line rounded-[22px] px-5 py-4 no-screenshot"><h3 class="font-serif font-bold text-base">왜 이 상인가요</h3><p class="mt-2 text-sm leading-relaxed">얼굴 선이 둥글고 턱까지 폭이 넉넉하게 이어져 토형으로 풀어요. 힘이 코와 광대가 있는 한가운데에 실려 있어서 사람과 일을 이어 가는 데 강한 얼굴이에요.</p><p class="mt-2 text-xs text-muted leading-relaxed">앞머리로 이마가 가려져 이마 자리는 추정이에요</p></section><section class="no-screenshot mt-4 bg-card-2 rounded-[22px] px-5 py-4"><h3 class="font-serif font-bold text-base">조심할 점</h3><p class="mt-2 text-sm leading-relaxed">써야 할 순간에도 계산부터 하기 쉬운 해예요.</p><p class="mt-1.5 text-sm leading-relaxed text-accent-ink">한 달에 한 번, 나를 위한 지출 하나를 정해 보세요.</p></section><section class="no-screenshot mt-3 bg-card-2 rounded-[22px] px-5 py-4"><h3 class="font-serif font-bold text-base">잘 맞는 상</h3><p class="mt-2 text-sm font-bold">번뜩이는 상</p><p class="mt-1 text-sm leading-relaxed">불이 흙을 단단히 굳히듯 번뜩이는 상이 쌓아 둔 것에 새 쓰임새를 비춰 줘요.</p></section><p class="no-screenshot mt-4 text-xs text-muted leading-relaxed text-center">관상은 오랜 전통의 해석 놀이이고 과학적 진단이 아니에요. 사진의 윤곽과 비율을 전통 틀에 맞춰 재미로 풀어본 결과예요.</p></div>"`;

